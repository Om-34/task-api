# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3f2c7c8b9adde98b34bcaecebe66e65ed29b14347c94a363bc584f3e2c5a91f7

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./app.db

# Or PostgreSQL, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_manager

# Comma-separated list of frontend origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
